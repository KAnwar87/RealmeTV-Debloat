+ *
+ * <p>Data: a whole month per request from api.waktusolat.app (JAKIM e-Solat data), with JAKIM's own
+ * e-solat.gov.my as the fallback. The current and the next month are cached in the app's files, so
+ * the line keeps working offline and across the change of month. A failed download is retried after
+ * {@link #RETRY_MS}.
+ */
+final class PrayerTimes {
+
+    private static final String TAG = "TvHome.Prayer";
+    static final String DEFAULT_ZONE = "SGR01";
+    private static final String[] NAMES = {"Subuh", "Zohor", "Asar", "Maghrib", "Isyak"};
+    private static final String[] HIJRI_MONTHS = {"Muharram", "Safar", "Rabiulawal", "Rabiulakhir",
+            "Jamadilawal", "Jamadilakhir", "Rejab", "Syaaban", "Ramadan", "Syawal", "Zulkaedah", "Zulhijjah"};
+    private static final TimeZone MYT = TimeZone.getTimeZone("Asia/Kuala_Lumpur");
+    private static final long RETRY_MS = 30 * 60_000L;
+    private static final int TIMEOUT_MS = 15_000;
+
+    /** One day: its Hijri date ("1448-05-14") and the five prayer times in epoch milliseconds. */
+    static final class Day {
+        final String hijri;
+        final long[] times;
+
+        Day(String hijri, long[] times) {
+            this.hijri = hijri;
+            this.times = times;
+        }
+    }
+
+    private final File dir;
+    final String zone;
+    final boolean enabled;
+    private final Map<String, Day[]> months = new HashMap<>();
+    private volatile boolean fetching;
+    private long lastAttempt;
+
+    PrayerTimes(Context ctx) {
+        dir = new File(ctx.getFilesDir(), "prayer");
+        //noinspection ResultOfMethodCallIgnored
+        dir.mkdirs();
+        // Optional keys in the theme's config.json: "prayer_times": false hides the line,
+        // "prayer_zone": "WLY01" picks another JAKIM zone.
+        String z = DEFAULT_ZONE;
+        boolean on = true;
+        try {
+            File cfg = new File(ctx.getExternalFilesDir(null), Config.FILE_NAME);
+            if (cfg.isFile()) {
+                JSONObject json = new JSONObject(new String(read(new FileInputStream(cfg), 64 * 1024),
+                        StandardCharsets.UTF_8));
+                on = json.optBoolean("prayer_times", true);
+                String fromCfg = json.optString("prayer_zone", "").trim().toUpperCase(Locale.ROOT);
+                if (fromCfg.matches("[A-Z]{3}\\d{2}")) z = fromCfg;
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "config.json not read: " + e);
+        }
+        zone = z;
+        enabled = on;
+    }
+
+    // ---- what the screen shows -------------------------------------------------------------------
+
+    /** What the card shows: five times ("5:49" + "am"), the names, which one is next, and the countdown. */
+    static final class Display {
+        final String[] names = new String[5];
+        final String[] times = new String[5];
+        final String[] ampm = new String[5];
+        int next = -1;
+        String countdown;
+    }
+
+    /**
+     * Today's five prayers (after Isyak: tomorrow's, with Subuh next) and the countdown "Isyak in 40min".
+     * Null when today's times are not known yet.
+     */
+    Display display(long now) {
+        Calendar c = Calendar.getInstance(MYT);
+        c.setTimeInMillis(now);
+        Day shown = day(c);
+        if (shown == null) return null;
+        int next = -1;
+        for (int i = 0; i < 5; i++) {
+            if (shown.times[i] > now) {
+                next = i;
+                break;
+            }
+        }
+        if (next < 0) {
+            Calendar t = (Calendar) c.clone();
+            t.add(Calendar.DAY_OF_MONTH, 1);
+            Day tomorrow = day(t);
+            if (tomorrow != null) {
+                shown = tomorrow;
+                next = 0;
+            }
+        }
+        SimpleDateFormat hm = new SimpleDateFormat("h:mm", Locale.ENGLISH);
+        SimpleDateFormat ap = new SimpleDateFormat("a", Locale.ENGLISH);
+        hm.setTimeZone(MYT);
+        ap.setTimeZone(MYT);
+        Display d = new Display();
+        d.next = next;
+        for (int i = 0; i < 5; i++) {
+            d.names[i] = NAMES[i].toUpperCase(Locale.ENGLISH);
+            d.times[i] = hm.format(shown.times[i]);
+            d.ampm[i] = ap.format(shown.times[i]).toLowerCase(Locale.ENGLISH);
+        }
+        if (next >= 0) d.countdown = NAMES[next] + " in " + countdown(shown.times[next] - now);
+        return d;
+    }
+
+    /** "14 Jamadilawal 1448" for today, or null when unknown. */
+    String hijriToday(long now) {
+        Calendar c = Calendar.getInstance(MYT);
+        c.setTimeInMillis(now);
+        Day today = day(c);
+        if (today == null || today.hijri == null) return null;
+        String[] p = today.hijri.split("-");
+        if (p.length != 3) return null;
+        try {
+            int m = Integer.parseInt(p[1]);
+            int d = Integer.parseInt(p[2]);
+            if (m < 1 || m > 12) return null;
+            return d + " " + HIJRI_MONTHS[m - 1] + " " + p[0];
+        } catch (NumberFormatException e) {
+            return null;
+        }
+    }
+
+    /** "25min", "1h 5min", "2h". Rounded up, so it reads "1min" until it is time. */
+    static String countdown(long ms) {
+        long min = Math.max(1, (ms + 59_999) / 60_000);
+        if (min < 60) return min + "min";
+        long h = min / 60;
+        long m = min % 60;
+        return m == 0 ? h + "h" : h + "h " + m + "min";
+    }
+
+    // ---- data ------------------------------------------------------------------------------------
+
+    /**
+     * Downloads the current and the next month if either is missing. Runs in the background; calls
+     * {@code done} on the handler's thread when something new arrived.
+     */
+    void refreshIfNeeded(Handler handler, Runnable done) {
+        if (!enabled || fetching) return;
+        Calendar now = Calendar.getInstance(MYT);
+        Calendar next = (Calendar) now.clone();
+        next.set(Calendar.DAY_OF_MONTH, 1);
+        next.add(Calendar.MONTH, 1);
+        final boolean needNow = month(now) == null;
+        final boolean needNext = month(next) == null;
+        if (!needNow && !needNext) return;
+        long t = android.os.SystemClock.elapsedRealtime();
+        if (lastAttempt != 0 && t - lastAttempt < RETRY_MS) return;
+        lastAttempt = t;
+        fetching = true;
+        final int y1 = now.get(Calendar.YEAR), m1 = now.get(Calendar.MONTH) + 1;
+        final int y2 = next.get(Calendar.YEAR), m2 = next.get(Calendar.MONTH) + 1;
+        new Thread(() -> {
+            boolean got = false;
+            try {
+                if (needNow) got |= fetchAndStore(y1, m1);
+                if (needNext) got |= fetchAndStore(y2, m2);
+            } finally {
+                fetching = false;
+            }
+            if (got) handler.post(done);
+        }, "prayer-times").start();
+    }
+
+    private Day day(Calendar c) {
+        Day[] m = month(c);
+        int d = c.get(Calendar.DAY_OF_MONTH);
+        return m != null && d <= m.length ? m[d - 1] : null;
+    }
+
+    private synchronized Day[] month(Calendar c) {
+        String key = key(c.get(Calendar.YEAR), c.get(Calendar.MONTH) + 1);
+        Day[] m = months.get(key);
+        if (m != null) return m;
+        File f = new File(dir, key + ".json");
+        if (!f.isFile()) return null;
+        try {
+            m = parseStored(new String(read(new FileInputStream(f), 256 * 1024), StandardCharsets.UTF_8));
+            months.put(key, m);
+            return m;
+        } catch (Exception e) {
+            Log.w(TAG, "bad cache " + f + ": " + e);
+            //noinspection ResultOfMethodCallIgnored
+            f.delete();
+            return null;
+        }
+    }
+
+    private String key(int y, int m) {
+        return zone + "-" + y + "-" + (m < 10 ? "0" : "") + m;
+    }
+
+    private boolean fetchAndStore(int y, int m) {
+        Day[] days = null;
+        try {
+            days = fromWaktuSolat(y, m);
+        } catch (Exception e) {
+            Log.w(TAG, "waktusolat.app failed for " + key(y, m) + ": " + e);
+        }
+        if (days == null) {
+            try {
+                days = fromJakim(y, m);
+            } catch (Exception e) {
+                Log.w(TAG, "e-solat.gov.my failed for " + key(y, m) + ": " + e);
+            }
+        }
+        if (days == null) return false;
+        try {
+            JSONArray arr = new JSONArray();
+            for (Day d : days) {
+                JSONObject o = new JSONObject();
+                o.put("h", d.hijri == null ? "" : d.hijri);
+                JSONArray t = new JSONArray();
+                for (long v : d.times) t.put(v);
+                o.put("t", t);
+                arr.put(o);
+            }
+            File tmp = new File(dir, key(y, m) + ".tmp");
+            try (OutputStream out = new FileOutputStream(tmp)) {
+                out.write(arr.toString().getBytes(StandardCharsets.UTF_8));
+            }
+            //noinspection ResultOfMethodCallIgnored
+            tmp.renameTo(new File(dir, key(y, m) + ".json"));
+            synchronized (this) {
+                months.put(key(y, m), days);
+            }
+            pruneOld(y, m);
+            Log.i(TAG, "cached " + key(y, m) + " (" + days.length + " days)");
+            return true;
+        } catch (Exception e) {
+            Log.w(TAG, "could not cache " + key(y, m) + ": " + e);
+            return false;
+        }
+    }
+
+    /** Keeps only the last few months' files. */
+    private void pruneOld(int y, int m) {
+        File[] files = dir.listFiles();
+        if (files == null) return;
+        int keepFrom = y * 12 + m - 3;
+        for (File f : files) {
+            String n = f.getName();
+            String[] p = n.replace(".json", "").split("-");
+            if (p.length != 3) continue;
+            try {
+                if (Integer.parseInt(p[1]) * 12 + Integer.parseInt(p[2]) < keepFrom) {
+                    //noinspection ResultOfMethodCallIgnored
+                    f.delete();
+                }
+            } catch (NumberFormatException ignored) {
+            }
+        }
+    }
+
+    private static Day[] parseStored(String s) throws Exception {
+        JSONArray arr = new JSONArray(s);
+        Day[] days = new Day[arr.length()];
+        for (int i = 0; i < arr.length(); i++) {
+            JSONObject o = arr.getJSONObject(i);
+            JSONArray t = o.getJSONArray("t");
+            long[] times = new long[5];
+            for (int k = 0; k < 5; k++) times[k] = t.getLong(k);
+            days[i] = new Day(o.optString("h", null), times);
+        }
+        return validate(days);
+    }
+
+    /** api.waktusolat.app: epoch seconds per prayer, one row per day of the month. */
+    private Day[] fromWaktuSolat(int y, int m) throws Exception {
+        String body = get("https://api.waktusolat.app/v2/solat/" + zone + "?year=" + y + "&month=" + m, null);
+        JSONObject json = new JSONObject(body);
+        if (json.optInt("month_number") != m || json.optInt("year") != y
+                || !zone.equalsIgnoreCase(json.optString("zone"))) {
+            throw new IllegalStateException("unexpected month/zone in reply");
+        }
+        JSONArray rows = json.getJSONArray("prayers");
+        Day[] days = new Day[rows.length()];
+        String[] keys = {"fajr", "dhuhr", "asr", "maghrib", "isha"};
+        for (int i = 0; i < rows.length(); i++) {
+            JSONObject r = rows.getJSONObject(i);
+            if (r.getInt("day") != i + 1) throw new IllegalStateException("days out of order");
+            long[] t = new long[5];
+            for (int k = 0; k < 5; k++) t[k] = r.getLong(keys[k]) * 1000L;
+            days[i] = new Day(r.optString("hijri", null), t);
+        }
+        return validate(days);
+    }
+
+    /** e-solat.gov.my (JAKIM): "HH:mm:ss" local times, one row per date in the range. */
+    private Day[] fromJakim(int y, int m) throws Exception {
+        Calendar c = Calendar.getInstance(MYT);
+        c.clear();
+        c.set(y, m - 1, 1);
+        int last = c.getActualMaximum(Calendar.DAY_OF_MONTH);
+        String mm = (m < 10 ? "0" : "") + m;
+        String body = get("https://www.e-solat.gov.my/index.php?r=esolatApi/TakwimSolat&period=duration&zone=" + zone,
+                "datestart=" + y + "-" + mm + "-01&dateend=" + y + "-" + mm + "-" + last);
+        JSONArray rows = new JSONObject(body).getJSONArray("prayerTime");
+        if (rows.length() != last) throw new IllegalStateException("expected " + last + " days, got " + rows.length());
+        Day[] days = new Day[last];
+        String[] keys = {"fajr", "dhuhr", "asr", "maghrib", "isha"};
+        for (int i = 0; i < last; i++) {
+            JSONObject r = rows.getJSONObject(i);
+            int d = Integer.parseInt(r.getString("date").substring(0, 2));
+            if (d != i + 1) throw new IllegalStateException("days out of order");
+            long[] t = new long[5];
+            for (int k = 0; k < 5; k++) {
+                String[] hms = r.getString(keys[k]).split(":");
+                Calendar at = Calendar.getInstance(MYT);
+                at.clear();
+                at.set(y, m - 1, d, Integer.parseInt(hms[0]), Integer.parseInt(hms[1]), 0);
+                t[k] = at.getTimeInMillis();
+            }
+            days[i] = new Day(r.optString("hijri", null), t);
+        }
+        return validate(days);
+    }
+
+    /** At least 28 days, each with five times in order on the same day. */
+    private static Day[] validate(Day[] days) {
+        if (days == null || days.length < 28 || days.length > 31) throw new IllegalStateException("bad month length");
+        for (Day d : days) {
+            if (d == null || d.times.length != 5) throw new IllegalStateException("bad day");
+            for (int k = 1; k < 5; k++) {
+                if (d.times[k] <= d.times[k - 1]) throw new IllegalStateException("times out of order");
+            }
+            if (d.times[4] - d.times[0] > 20 * 3600_000L) throw new IllegalStateException("times span too long");
+        }
+        return days;
+    }
+
+    private static String get(String url, String postBody) throws Exception {
+        HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+        try {
+            c.setConnectTimeout(TIMEOUT_MS);
+            c.setReadTimeout(TIMEOUT_MS);
+            c.setRequestProperty("Accept", "application/json");
+            c.setRequestProperty("User-Agent", "GlassTV-Launcher");
+            if (postBody != null) {
+                c.setRequestMethod("POST");
+                c.setDoOutput(true);
+                c.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
+                try (OutputStream out = c.getOutputStream()) {
+                    out.write(postBody.getBytes(StandardCharsets.UTF_8));
+                }
+            }
+            if (c.getResponseCode() != 200) throw new IllegalStateException("HTTP " + c.getResponseCode());
+            return new String(read(c.getInputStream(), 512 * 1024), StandardCharsets.UTF_8);
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    private static byte[] read(InputStream in, int max) throws Exception {
+        try (InputStream is = in) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[8192];
+            int n;
+            while ((n = is.read(buf)) > 0) {
+                out.write(buf, 0, n);
+                if (out.size() > max) throw new IllegalStateException("reply too large");
+            }
+            return out.toByteArray();
+        }
+    }
+}
